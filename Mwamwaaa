        .big-heart {
            font-size: 90px;
            animation: heartbeat 1s infinite;
        }

        .signature {
            margin-top: 25px;
            color: #888;
            font-style: italic;
        }

        /* Confetti */
        .confetti {
            position: fixed;
            top: -20px;
            z-index: 100;

            animation: fall 3s linear forwards;
        }

        @keyframes fall {
            from {
                transform: translateY(0) rotate(0deg);
            }

            to {
                transform: translateY(110vh) rotate(720deg);
            }
        }

        @media (max-width: 500px) {

            .container {
                padding: 35px 20px;
