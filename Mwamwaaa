```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>For Icyl Kaye ❤️</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: Arial, sans-serif;

            background: linear-gradient(
                135deg,
                #ff758c,
                #ff7eb3,
                #a18cd1
            );
        }

        /* Floating hearts */
        .heart {
            position: absolute;
            bottom: -50px;
            font-size: 25px;
            animation: floatUp linear infinite;
            opacity: 0.7;
            pointer-events: none;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(0) rotate(0deg);
                opacity: 0;
            }

            20% {
                opacity: 0.8;
            }

            100% {
                transform: translateY(-110vh) rotate(360deg);
                opacity: 0;
            }
        }

        /* Main card */
        .container {
            position: relative;
            width: 90%;
            max-width: 500px;
            padding: 45px 30px;
            text-align: center;

            background: rgba(255, 255, 255, 0.95);

            border-radius: 30px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.2);

            z-index: 10;
        }

        .heart-icon {
            font-size: 70px;
            animation: heartbeat 1.2s infinite;
        }

        @keyframes heartbeat {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.15);
            }
        }

        h1 {
            color: #ff4f81;
            font-size: 30px;
            margin: 20px 0 10px;
        }

        .name {
            color: #e63972;
            font-weight: bold;
        }

        p {
            color: #555;
            font-size: 17px;
            line-height: 1.6;
        }

        .question {
            margin: 25px 0;
            font-size: 23px;
            font-weight: bold;
            color: #333;
        }

        /* Buttons */
        .buttons {
            display: flex;
            justify-content: center;
            margin-top: 25px;
        }

        button {
            border: none;
            padding: 15px 35px;
            border-radius: 50px;

            font-size: 18px;
            font-weight: bold;

            cursor: pointer;
        }

        #yesButton {
            background: #ff4f81;
            color: white;

            box-shadow:
                0 5px 20px rgba(255, 79, 129, 0.4);

            transition: 0.3s;
        }

        #yesButton:hover {
            transform: scale(1.1);
            background: #ff2f6d;
        }

        #noButton {
            margin-left: 15px;
            background: #ddd;
            color: #777;
        }

        #noButton:hover {
            background: #bbb;
        }

        /* YES message */
        #loveMessage {
            display: none;
        }

        #loveMessage h2 {
            color: #ff3f78;
